# Copy to .env.local and fill in. Never commit .env.local.
# Sandbox only: this app has no setting for live PayPal.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal gives the webhook pointed at /api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Gemini, through the Vercel AI SDK
# vertex: Vertex AI in the app's GCP project (no key; uses gcloud or the Cloud Run service account)
# google: a Gemini API key
AI_PROVIDER=vertex
# The careful model, for work that can wait (the refund recount, dusk); and the
# fast one, for a customer waiting at the stand. Without it, both use GEMINI_MODEL.
GEMINI_MODEL=
GEMINI_FAST_MODEL=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Locally, bill API quota to the same project rather than your gcloud default
GOOGLE_CLOUD_QUOTA_PROJECT=
GOOGLE_GENERATIVE_AI_API_KEY=

# The stand used for the demo
STAND_CURRENCY=EUR
# The most the agent may refund on its own, in major units
STAND_REFUND_LIMIT=5.00
